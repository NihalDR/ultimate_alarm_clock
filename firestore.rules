rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write shared alarms so the shared
    // alarm inbox and listeners can function reliably.
    match /sharedAlarms/{alarmId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write their notification inbox.
    match /userNotifications/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to read and write their own shared profiles
    match /users/{userId}/sharedProfile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading all users for email lookup (needed for sharing)
    match /users/{userId} {
      allow read: if request.auth != null;
    }
  }
}
