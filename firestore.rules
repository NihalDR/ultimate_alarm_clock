rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shared alarms: authenticated reads; writes limited to owner/shared users
    match /sharedAlarms/{alarmId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.sharedUserIds
      );
    }
    
    // Allow users to read and write their own notifications
    match /userNotifications/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own shared profiles
    match /users/{userId}/sharedProfile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading all users for email lookup (needed for sharing)
    match /users/{userId} {
      allow read: if request.auth != null;
    }
  }
}
